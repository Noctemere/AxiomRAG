APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://axiom:axiom@localhost:5432/axiomrag
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=axiomrag_documents
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
ANSWER_MODEL=gpt-4o-mini
ANSWER_BASE_URL=https://api.openai.com/v1
ANSWER_API_KEY=
ANSWER_CACHE_TTL_SECONDS=300
SQL_ALLOWED_TABLES=documents,document_chunks
SQL_MAX_ROWS=100
SQL_TIMEOUT_SECONDS=5
SQL_API_KEY=
SQL_BASE_URL=https://api.openai.com/v1
SQL_MODEL=gpt-4o-mini
SQL_SCHEMA_DESCRIPTION=documents(document_id, tenant_id, filename); document_chunks(chunk_id, document_id, tenant_id, content)
AUTH_MODE=local
JWT_SECRET=
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
